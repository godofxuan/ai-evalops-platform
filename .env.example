EVALOPS_ENVIRONMENT=development
EVALOPS_LOG_LEVEL=INFO
EVALOPS_DATABASE_URL=postgresql+psycopg://evalops:evalops@localhost:5432/evalops
EVALOPS_REDIS_URL=redis://localhost:6379/0
EVALOPS_ARTIFACT_ROOT=data/artifacts
EVALOPS_ALEMBIC_CONFIG_PATH=alembic.ini
EVALOPS_READINESS_TIMEOUT_SECONDS=2.0
EVALOPS_DATASET_MAX_FILE_BYTES=10485760
EVALOPS_DATASET_MAX_CASES=10000
EVALOPS_DATASET_MAX_LINE_BYTES=1048576
EVALOPS_WORKER_LEASE_SECONDS=30
EVALOPS_WORKER_HEARTBEAT_SECONDS=10
EVALOPS_WORKER_CLAIM_BATCH_SIZE=1
EVALOPS_WORKER_POLL_SECONDS=0.5
EVALOPS_REAPER_INTERVAL_SECONDS=5.0
EVALOPS_REAPER_BATCH_SIZE=100
EVALOPS_RETRY_BASE_DELAY_SECONDS=1.0
EVALOPS_RETRY_MAX_DELAY_SECONDS=60.0
EVALOPS_RETRY_JITTER_RATIO=0.2
# Compose development/CI containment defaults. Tune with measured workload evidence.
EVALOPS_APP_CPUS=1.0
EVALOPS_APP_MEMORY_LIMIT=512m
EVALOPS_APP_PIDS_LIMIT=256
EVALOPS_POSTGRES_CPUS=1.0
EVALOPS_POSTGRES_MEMORY_LIMIT=512m
EVALOPS_POSTGRES_PIDS_LIMIT=256
EVALOPS_REDIS_CPUS=0.5
EVALOPS_REDIS_MEMORY_LIMIT=256m
EVALOPS_REDIS_PIDS_LIMIT=128
EVALOPS_SSE_HEARTBEAT_SECONDS=15.0
EVALOPS_SSE_FALLBACK_POLL_SECONDS=2.0
EVALOPS_METRICS_ENABLED=true
EVALOPS_METRICS_HOST=0.0.0.0
EVALOPS_WORKER_METRICS_PORT=9101
EVALOPS_REAPER_METRICS_PORT=9102
EVALOPS_HTTP_TARGET_REGISTRY={}
# Operator-managed example; keep bearer values out of this JSON and inject the named variable into the Worker process.
# EVALOPS_HTTP_TARGET_REGISTRY={"rag-production":{"version":"rag-v1","config":{"base_url":"https://rag.example.com","endpoint":"/v1/query","auth_env_var":"RAG_PRODUCTION_BEARER_TOKEN"}}}
EVALOPS_OTEL_ENABLED=true
EVALOPS_OTEL_SERVICE_NAME=ai-evalops-platform
# Optional OTLP/HTTP trace endpoint, for example:
# EVALOPS_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Optional secret headers use comma-separated key=value entries.
# EVALOPS_OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer replace-me
